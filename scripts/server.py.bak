              <th>Kategori</th>
              <th>Wallet</th>
              <th>Nominal</th>
              <th>Detail Struk OCR</th>
            </tr>
          </thead>
          <tbody>
            {"".join([f'''<tr>
              <td>{tx['waktu']}</td>
              <td><strong>{tx['deskripsi']}</strong></td>
              <td>{tx['kategori']}</td>
              <td>{tx['wallet']}</td>
              <td style="color:{'#22c55e' if tx['nominal'] > 0 else '#ef4444'}; font-weight:700;">
                {'+' if tx['nominal'] > 0 else '-'}Rp {abs(tx['nominal']):,}
              </td>
              <td>
                {'<button class="btn btn-secondary" style="padding:4px 8px; font-size:11px;" onclick="alert(\\\'Rincian Struk OCR Supermarket:\\\\n- Susu UHT 1L (Rp 22.000)\\\\n- Beras Ramos 5kg (Rp 75.000)\\\\n- Minyak Goreng 2L (Rp 38.000)\\\\n- Buah & Sayur (Rp 210.000)\\\')">👁️ Expand Multi-Item</button>' if 'Struk' in tx['deskripsi'] else '<span style="color:var(--text-muted); font-size:12px;">Single-item</span>'}
              </td>
            </tr>''' for tx in USER_TRANSACTIONS])}
          </tbody>
