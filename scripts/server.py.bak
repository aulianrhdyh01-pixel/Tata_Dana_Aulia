        # -------------------------------------------------------------
        # 6. REPORTS & EXPORT (/dashboard/reports)
        # -------------------------------------------------------------
        elif path == "/dashboard/reports":
            content = f"""
      <div class="topbar">
        <div>
          <h1 class="page-title">Laporan Keuangan & Export In-App</h1>
          <p class="page-sub">Filter data transaksi lengkap, sortir per kolom, dan generate PDF/Excel instan.</p>
        </div>
