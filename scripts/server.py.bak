      </div>
    </div>

    <!-- Alert Box Sukses Update Password -->
    <div id="loginSuccessNotice" style="display:none; background:rgba(34,197,94,0.15); border:1px solid #22c55e; border-radius:10px; padding:12px 14px; color:#86efac; font-size:13px; margin-bottom:16px;">
    </div>

    <form id="authForm" onsubmit="handleLogin(event)">
      <div class="form-group">
        <label>Nomor HP (Verifikasi OTP) atau Email</label>
