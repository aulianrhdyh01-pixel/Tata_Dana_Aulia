'''

            html = f'''<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>{title_text} — TataDana</title>
  <style>
    {COMMON_STYLES}
    body {{
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: var(--bg-dark);
      padding: 20px;
    }}
    .login-box {{
      background: var(--card-dark);
      border: 1px solid var(--border-dark);
      border-radius: 16px;
      padding: 36px;
      width: 100%;
      max-width: 460px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }}
    .form-group {{ margin-bottom: 16px; }}
    label {{ display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 600; }}
    input {{
      width: 100%;
      background: #18181b;
      border: 1px solid var(--border-dark);
      border-radius: 8px;
      padding: 11px 13px;
      color: var(--text-primary);
      font-size: 14px;
    }}
    input:focus {{ outline: 2px solid var(--primary-orange); }}
    .btn-login {{
      width: 100%;
      background: var(--primary-orange);
      color: #fff;
      padding: 13px;
      border-radius: 8px;
      border: none;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
      margin-top: 4px;
    }}
    .btn-login:hover {{ background: var(--primary-hover); }}
    .btn-google {{
      width: 100%;
      background: #18181b;
      color: var(--text-primary);
      border: 1px solid var(--border-dark);
      padding: 12px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      margin-bottom: 18px;
      transition: background 0.15s ease;
    }}
    .btn-google:hover {{ background: #27272a; }}
    .divider {{
      display: flex;
      align-items: center;
      text-align: center;
      margin: 18px 0;
      color: var(--text-muted);
      font-size: 12px;
    }}
    .divider::before, .divider::after {{
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--border-dark);
    }}
    .divider span {{ padding: 0 10px; }}
    .demo-callout {{
      margin-top: 22px;
      padding: 14px;
      background: rgba(249, 115, 22, 0.08);
      border: 1px solid rgba(249, 115, 22, 0.25);
      border-radius: 10px;
      text-align: center;
    }}
  </style>
</head>
<body>
  <div class="login-box">
    <div style="text-align:center; margin-bottom: 22px;">
      <div style="font-size: 26px; font-weight: 800; color: var(--text-primary);">Tata<span style="color:#f97316;">Dana</span></div>
      <p style="color:var(--text-secondary); font-size: 13px; margin: 4px 0 0;">{title_text}</p>
    </div>

    <button type="button" class="btn-google" onclick="handleGoogleAuth()">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
      {'Daftar Cepat dengan Google' if is_register else 'Lanjutkan dengan Google'}
    </button>

    <div class="divider"><span>{'atau isi formulir pendaftaran' if is_register else 'atau dengan Nomor HP / Email'}</span></div>

    {form_html}

    {alt_link}

    <div class="demo-callout">
      <div style="font-size: 13px; font-weight: 600; color: var(--text-primary);">🚀 Akses Cepat Mode Sandbox</div>
      <div style="font-size: 12px; color: var(--text-secondary); margin: 4px 0 10px;">Akun demo telah disiapkan dengan data transaksi dan multi-wallet.</div>
      <button onclick="handleDemoLogin()" class="btn btn-primary" style="width: 100%; font-size: 13px;">1-Click Masuk Demo &rarr;</button>
    </div>

    <div style="text-align:center; margin-top: 18px;">
      <a href="/" style="font-size: 13px; color: var(--text-muted);">&larr; Kembali ke Beranda</a>
    </div>
  </div>

  <!-- Modal Pemulihan Kata Sandi (Lupa Password) -->
  <div id="modalForgotPw" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.8); z-index:9999; align-items:center; justify-content:center; padding:16px;">
    <div style="background:#121215; border:1px solid #27272a; border-radius:16px; width:100%; max-width:440px; padding:24px; position:relative; box-shadow:0 20px 40px rgba(0,0,0,0.8);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="margin:0; font-size:18px; font-weight:800; color:#f4f4f5;">🔐 Pemulihan Kata Sandi</h3>
        <button onclick="closeForgotPwModal()" style="background:none; border:none; color:#a1a1aa; font-size:22px; cursor:pointer;">&times;</button>
      </div>

      <div id="forgotAlert" style="display:none; background:rgba(239,68,68,0.18); border:1px solid #ef4444; border-radius:8px; padding:10px 12px; color:#fca5a5; font-size:12px; margin-bottom:14px;"></div>
      <div id="forgotSuccessMsg" style="display:none; background:rgba(34,197,94,0.18); border:1px solid #22c55e; border-radius:8px; padding:10px 12px; color:#86efac; font-size:12px; margin-bottom:14px;"></div>

      <div id="forgotStep1">
        <p style="font-size:13px; color:#a1a1aa; margin:0 0 14px;">Masukkan Email atau Nomor Kontak terdaftar untuk menerima OTP pemulihan.</p>
        <div class="form-group">
          <label>Email atau Nomor Kontak Terdaftar</label>
          <input type="text" id="forgotTarget" placeholder="user@tatadana.com" required>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
          <button type="button" onclick="closeForgotPwModal()" class="btn btn-secondary">Batal</button>
          <button type="button" onclick="sendRecoveryOtp()" class="btn btn-primary">Kirim Kode OTP Pemulihan</button>
        </div>
      </div>

      <div id="forgotStep2" style="display:none;">
        <div style="background:rgba(249,115,22,0.12); border:1px solid rgba(249,115,22,0.4); border-radius:8px; padding:10px 12px; color:#fdba74; font-size:12px; margin-bottom:14px;">
          💡 <strong>Kode OTP Demo:</strong> Masukkan kode <span style="background:rgba(0,0,0,0.5); padding:2px 6px; border-radius:4px; font-weight:800; font-family:monospace; color:#fff;">123456</span>
        </div>
        <div class="form-group">
          <label>Kode OTP 6-Digit</label>
          <input type="text" id="forgotOtpCode" placeholder="123456" maxlength="6" style="text-align:center; font-size:18px; font-family:monospace; letter-spacing:4px;" required>
        </div>
        <div class="form-group">
          <label>Kata Sandi Baru</label>
          <input type="password" id="forgotNewPass" placeholder="Minimal 6 karakter" minlength="6" required>
        </div>
        <div class="form-group">
          <label>Konfirmasi Kata Sandi Baru</label>
          <input type="password" id="forgotConfirmPass" placeholder="Ulangi kata sandi baru" minlength="6" required>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
          <button type="button" onclick="document.getElementById('forgotStep1').style.display='block'; document.getElementById('forgotStep2').style.display='none';" class="btn btn-secondary" style="font-size:12px;">&larr; Kembali</button>
          <button type="button" onclick="submitResetPassword()" class="btn btn-primary">Simpan Kata Sandi Baru</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Inisialisasi daftar pengguna terdaftar tatadana_registered_users
    function getRegisteredUsers() {{
      var def = [
        {{ nama: 'Pengguna TataDana', email: 'user@tatadana.com', kontak: '+62 812-3456-7890', password: 'password123', avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=TataDanaUser', statusPaket: 'Pro Lifetime (Rp99k)', isVerified: true }},
        {{ nama: 'Budi Santoso', email: 'budi.santoso@tatadana.id', kontak: '+62 812-8899-0011', password: 'password123', avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=BudiSantoso', statusPaket: 'Pro Lifetime (Rp99k)', isVerified: true }},
        {{ nama: 'Super Admin TataDana', email: 'admin@tatadana.com', kontak: '+62 811-9988-7766', password: 'password123', avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=TataDanaAdmin', statusPaket: 'Pro Lifetime (Rp99k)', isVerified: true }},
        {{ nama: 'Budi Santoso', email: 'user@tatadana.id', kontak: '+62 812-3456-7890', password: 'password123', avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=BudiSantoso', statusPaket: 'Pro Lifetime (Rp99k)', isVerified: true }}
      ];
      try {{
        var raw = localStorage.getItem('tatadana_registered_users');
        if (!raw) {{
          localStorage.setItem('tatadana_registered_users', JSON.stringify(def));
          return def;
        }}
        var parsed = JSON.parse(raw);
        if (!Array.isArray(parsed) || parsed.length === 0) {{
          localStorage.setItem('tatadana_registered_users', JSON.stringify(def));
          return def;
        }}
        return parsed;
      }} catch(e) {{
        return def;
      }}
    }}

    function saveRegisteredUsers(users) {{
      try {{
        localStorage.setItem('tatadana_registered_users', JSON.stringify(users));
      }} catch(e) {{}}
    }}

    function findRegisteredUser(identifier) {{
      var users = getRegisteredUsers();
      var idTrim = identifier.trim().toLowerCase();
      var digits = idTrim.replace(/\\D/g, '');
      for (var i = 0; i < users.length; i++) {{
        var u = users[i];
        if (u.email && u.email.toLowerCase() === idTrim) return u;
        if (u.kontak) {{
          if (u.kontak.toLowerCase() === idTrim) return u;
          var uDigits = u.kontak.replace(/\\D/g, '');
          if (digits && digits.length >= 8 && uDigits.endsWith(digits.slice(-8))) return u;
        }}
      }}
      return null;
    }}

    // State temporary registrasi
    var tempRegData = null;

    function handleRegisterStep1(e) {{
      e.preventDefault();
      var errBox = document.getElementById('regAlertError');
      if (errBox) errBox.style.display = 'none';

      var name = document.getElementById('regName').value.trim();
      var phone = document.getElementById('regPhone').value.trim();
      var email = document.getElementById('regEmail').value.trim();
      var password = document.getElementById('regPassword').value;

      if (!name || !phone || !email || !password) {{
        if (errBox) {{
          errBox.textContent = 'Semua field formulir wajib diisi.';
          errBox.style.display = 'block';
        }}
        return;
      }}
      if (password.length < 6) {{
        if (errBox) {{
          errBox.textContent = 'Kata sandi minimal 6 karakter.';
          errBox.style.display = 'block';
        }}
        return;
      }}

      var cleanPhone = phone.startsWith('+') ? phone : (phone.startsWith('0') ? '+62 ' + phone.slice(1) : '+62 ' + phone);

      tempRegData = {{
        nama: name,
        kontak: cleanPhone,
        email: email,
        password: password,
        avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(name),
        statusPaket: 'Pro Lifetime (Rp99k)',
        isVerified: true
      }};

      document.getElementById('regStep1').style.display = 'none';
      document.getElementById('regStep2').style.display = 'block';
    }}

    function backToRegStep1() {{
      document.getElementById('regStep2').style.display = 'none';
      document.getElementById('regStep1').style.display = 'block';
    }}

    function handleRegisterStep2(e) {{
      e.preventDefault();
      var errBox = document.getElementById('regAlertError');
      var otp = document.getElementById('regOtp').value.trim();

      if (otp !== '123456') {{
        if (errBox) {{
          errBox.textContent = '❌ Kode OTP yang Anda masukkan salah. Gunakan kode verifikasi demo: 123456';
          errBox.style.display = 'block';
        }}
        return;
      }}

      if (!tempRegData) {{
        backToRegStep1();
        return;
      }}

      // Simpan ke tatadana_registered_users dengan status terverifikasi (isVerified: true)
      var users = getRegisteredUsers();
      var idx = users.findIndex(function(u) {{
        return (u.email && u.email.toLowerCase() === tempRegData.email.toLowerCase()) ||
               (u.kontak && u.kontak === tempRegData.kontak);
      }});
      if (idx >= 0) {{
        users[idx] = tempRegData;
      }} else {{
        users.push(tempRegData);
      }}
      saveRegisteredUsers(users);

      // Simpan sesi aktif
      var profile = {{
        nama: tempRegData.nama,
        kontak: tempRegData.kontak,
        email: tempRegData.email,
        avatarUrl: tempRegData.avatarUrl,
        statusPaket: tempRegData.statusPaket,
        isLoggedIn: true
      }};
      try {{
        localStorage.setItem('tatadana_user_profile', JSON.stringify(profile));
        localStorage.setItem('user_profile', JSON.stringify(profile));
        localStorage.setItem('tatadana_user', JSON.stringify(profile));
      }} catch(err) {{}}

      window.location.href = '/dashboard';
    }}

    function clearLoginAlerts() {{
      var pErr = document.getElementById('loginPassError');
      var uWarn = document.getElementById('loginUnregisteredWarning');
      var passInput = document.getElementById('loginPassword');
      if (pErr) pErr.style.display = 'none';
      if (uWarn) uWarn.style.display = 'none';
      if (passInput) {{
        passInput.style.borderColor = 'var(--border-dark)';
        passInput.style.outline = 'none';
      }}
    }}

    function handleLogin(e) {{
      e.preventDefault();
      clearLoginAlerts();

      var contactInput = document.getElementById('loginContact');
      var passInput = document.getElementById('loginPassword');
      var contact = contactInput ? contactInput.value.trim() : '';
      var password = passInput ? passInput.value.trim() : '';

      var user = findRegisteredUser(contact);

      // Requirement 4: Akun belum terdaftar tidak boleh langsung masuk
      if (!user) {{
        var uWarn = document.getElementById('loginUnregisteredWarning');
        if (uWarn) {{
          uWarn.innerHTML = '⚠️ <strong>Akun belum terdaftar.</strong> Anda harus mendaftar dan memverifikasi akun terlebih dahulu sebelum bisa masuk.<div style="margin-top:8px;"><a href="/register" class="btn btn-primary" style="font-size:12px; padding:6px 12px; display:inline-block;">Daftar Akun Baru &rarr;</a></div>';
          uWarn.style.display = 'block';
        }}
        return;
      }}

      // Requirement 4: Akun belum diverifikasi tidak boleh langsung masuk
      if (user.isVerified === false) {{
        var uWarn = document.getElementById('loginUnregisteredWarning');
        if (uWarn) {{
          uWarn.innerHTML = '⚠️ <strong>Akun ini belum diverifikasi.</strong> Anda harus menyelesaikan verifikasi akun terlebih dahulu sebelum bisa masuk.<div style="margin-top:8px;"><a href="/register" class="btn btn-primary" style="font-size:12px; padding:6px 12px; display:inline-block;">Verifikasi Akun Sekarang &rarr;</a></div>';
          uWarn.style.display = 'block';
        }}
        return;
      }}

      // Requirement 3: Peringatan Password Salah & highlight border merah
      var expectedPass = user.password || 'password123';
      if (password !== expectedPass) {{
        var pErr = document.getElementById('loginPassError');
        if (pErr) pErr.style.display = 'block';
        if (passInput) {{
          passInput.style.borderColor = '#ef4444';
          passInput.style.outline = '2px solid #ef4444';
        }}
        return;
      }}

      // Login Sukses
      var profile = {{
        nama: user.nama,
        kontak: user.kontak,
        email: user.email,
        avatarUrl: user.avatarUrl,
        statusPaket: user.statusPaket || 'Pro Lifetime (Rp99k)',
        isLoggedIn: true
      }};

      try {{
        localStorage.setItem('tatadana_user_profile', JSON.stringify(profile));
        localStorage.setItem('user_profile', JSON.stringify(profile));
        localStorage.setItem('tatadana_user', JSON.stringify(profile));
      }} catch(err) {{}}

      window.location.href = '/dashboard';
    }}

    // -------------------------------------------------------------
    // Fitur Lupa Password (Lupa PW)
    // -------------------------------------------------------------
    function openForgotPwModal(e) {{
      if (e) e.preventDefault();
      var c = document.getElementById('loginContact');
      var targetInput = document.getElementById('forgotTarget');
      if (c && targetInput) targetInput.value = c.value.trim();

      document.getElementById('forgotAlert').style.display = 'none';
      document.getElementById('forgotSuccessMsg').style.display = 'none';
      document.getElementById('forgotStep1').style.display = 'block';
      document.getElementById('forgotStep2').style.display = 'none';
      document.getElementById('modalForgotPw').style.display = 'flex';
    }}

    function closeForgotPwModal() {{
      document.getElementById('modalForgotPw').style.display = 'none';
    }}

    function sendRecoveryOtp() {{
      var target = document.getElementById('forgotTarget').value.trim();
      var alertBox = document.getElementById('forgotAlert');
      alertBox.style.display = 'none';

      if (!target) {{
        alertBox.textContent = 'Masukkan email atau nomor kontak terdaftar.';
        alertBox.style.display = 'block';
        return;
      }}

      var user = findRegisteredUser(target);
      if (!user) {{
        alertBox.textContent = '⚠️ Akun tidak ditemukan dalam sistem terdaftar.';
        alertBox.style.display = 'block';
        return;
      }}

      document.getElementById('forgotStep1').style.display = 'none';
      document.getElementById('forgotStep2').style.display = 'block';
    }}

    function submitResetPassword() {{
      var target = document.getElementById('forgotTarget').value.trim();
      var otp = document.getElementById('forgotOtpCode').value.trim();
      var newPass = document.getElementById('forgotNewPass').value;
      var confPass = document.getElementById('forgotConfirmPass').value;
      var alertBox = document.getElementById('forgotAlert');
      var successBox = document.getElementById('forgotSuccessMsg');
      alertBox.style.display = 'none';

      if (otp !== '123456') {{
        alertBox.textContent = '❌ Kode OTP salah. Gunakan kode pemulihan demo: 123456';
        alertBox.style.display = 'block';
        return;
      }}
      if (newPass.length < 6) {{
        alertBox.textContent = 'Kata sandi baru minimal 6 karakter.';
        alertBox.style.display = 'block';
        return;
      }}
      if (newPass !== confPass) {{
        alertBox.textContent = 'Konfirmasi kata sandi tidak cocok.';
        alertBox.style.display = 'block';
        return;
      }}

      var users = getRegisteredUsers();
      var user = findRegisteredUser(target);
      if (user) {{
        for (var i = 0; i < users.length; i++) {{
          if ((user.email && users[i].email && users[i].email.toLowerCase() === user.email.toLowerCase()) ||
              (user.kontak && users[i].kontak && users[i].kontak === user.kontak)) {{
            users[i].password = newPass;
            break;
          }}
        }}
        saveRegisteredUsers(users);

        successBox.textContent = '✅ Kata sandi berhasil diperbarui! Silakan masuk dengan kata sandi baru Anda.';
        successBox.style.display = 'block';

        setTimeout(function() {{
          closeForgotPwModal();
          var pInp = document.getElementById('loginPassword');
          if (pInp) pInp.value = newPass;
          var sNotice = document.getElementById('loginSuccessNotice');
          if (sNotice) {{
            sNotice.textContent = '✅ Kata sandi baru telah tersimpan. Silakan klik tombol Masuk ke Dashboard.';
            sNotice.style.display = 'block';
          }}
        }}, 1600);
      }}
    }}

    function handleGoogleAuth() {{
      var googleProfile = {{
        nama: 'Pengguna TataDana (Google)',
        kontak: '+62 812-3456-7890',
        email: 'user.google@tatadana.id',
        avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=GoogleUserTataDana',
        statusPaket: 'Pro Lifetime (Rp99k)',
        isLoggedIn: true
      }};
      try {{
        localStorage.setItem('tatadana_user_profile', JSON.stringify(googleProfile));
        localStorage.setItem('user_profile', JSON.stringify(googleProfile));
        localStorage.setItem('tatadana_user', JSON.stringify(googleProfile));
      }} catch(err) {{}}
      window.location.href = '/dashboard';
    }}

    function handleDemoLogin() {{
      var demoProfile = {{
        nama: 'Budi Santoso (Demo)',
        kontak: '+62 812-3456-7890',
        email: 'budi.santoso@tatadana.id',
        avatarUrl: 'https://api.dicebear.com/7.x/avataaars/svg?seed=BudiSantosoDemo',
        statusPaket: 'Pro Lifetime (Rp99k)',
        isLoggedIn: true
      }};
      try {{
        localStorage.setItem('tatadana_user_profile', JSON.stringify(demoProfile));
        localStorage.setItem('user_profile', JSON.stringify(demoProfile));
        localStorage.setItem('tatadana_user', JSON.stringify(demoProfile));
      }} catch(err) {{}}
      window.location.href = '/dashboard';
    }}
  </script>
</body>
</html>'''
            self.send_html(html)
