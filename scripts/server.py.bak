          </div>

          <!-- Error Alert Box -->
          <div id="modalErrorMsg" style="display:none; color:#f87171; background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); border-radius:8px; padding:10px 14px; font-size:13px; margin-bottom:16px;"></div>

          <form id="addWalletForm" onsubmit="event.preventDefault(); submitAddWallet();">
            <!-- 1. Nama Wallet / Akun -->
            <div style="margin-bottom:16px;">
              <label style="display:block; font-size:13px; font-weight:600; color:#d4d4d8; margin-bottom:6px;">Nama Wallet / Akun <span style="color:#f97316;">*</span></label>
              <input type="text" id="walletName" placeholder="contoh: Bank Jago, DANA, Dompet Fisik" oninput="var e=document.getElementById('modalErrorMsg'); if(e) e.style.display='none';" style="width:100%; background:#121215; border:1px solid #27272a; padding:10px 14px; color:#f4f4f5; border-radius:8px; font-size:14px; outline:none; transition:border 0.2s;" onfocus="this.style.borderColor='var(--primary-orange)'" onblur="this.style.borderColor='#27272a'">
            </div>

            <!-- 2. Tipe / Kategori Wallet -->
            <div style="margin-bottom:16px;">
              <label style="display:block; font-size:13px; font-weight:600; color:#d4d4d8; margin-bottom:6px;">Tipe / Kategori Wallet <span style="color:#f97316;">*</span></label>
              <select id="walletType" style="width:100%; background:#121215; border:1px solid #27272a; padding:10px 14px; color:#f4f4f5; border-radius:8px; font-size:14px; outline:none;" onfocus="this.style.borderColor='var(--primary-orange)'" onblur="this.style.borderColor='#27272a'">
                <option value="Bank Rekening">Bank Rekening</option>
                <option value="E-Wallet">E-Wallet</option>
                <option value="Dompet Kas / Tunai">Dompet Kas / Tunai</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>

            <!-- 3. Saldo Awal with Auto-Rupiah -->
            <div style="margin-bottom:16px;">
              <label style="display:block; font-size:13px; font-weight:600; color:#d4d4d8; margin-bottom:6px;">Saldo Awal <span style="color:#f97316;">*</span></label>
              <input type="text" id="walletBalance" placeholder="contoh: Rp 500.000" oninput="formatRupiahInput(this); var e=document.getElementById('modalErrorMsg'); if(e) e.style.display='none';" style="width:100%; background:#121215; border:1px solid #27272a; padding:10px 14px; color:#f4f4f5; border-radius:8px; font-size:14px; font-weight:700; outline:none;" onfocus="this.style.borderColor='var(--primary-orange)'" onblur="this.style.borderColor='#27272a'">
            </div>

            <!-- 4. Catatan / Keterangan -->
            <div style="margin-bottom:16px;">
              <label style="display:block; font-size:13px; font-weight:600; color:#d4d4d8; margin-bottom:6px;">Catatan / Keterangan <span style="color:#71717a; font-weight:normal;">(Opsional)</span></label>
              <input type="text" id="walletNote" placeholder="contoh: Rekening tabungan liburan, dana darurat" style="width:100%; background:#121215; border:1px solid #27272a; padding:10px 14px; color:#f4f4f5; border-radius:8px; font-size:14px; outline:none;" onfocus="this.style.borderColor='var(--primary-orange)'" onblur="this.style.borderColor='#27272a'">
            </div>

            <!-- 5. Checkbox Jadikan Default untuk Telegram -->
            <div style="margin-bottom:24px; display:flex; align-items:flex-start; gap:10px; padding:6px 0;">
              <input type="checkbox" id="walletIsDefault" style="width:18px; height:18px; margin-top:2px; accent-color:var(--primary-orange); cursor:pointer;">
              <label for="walletIsDefault" style="font-size:13px; color:#d4d4d8; cursor:pointer; user-select:none; line-height:1.4;">
                Jadikan Default untuk Telegram
                <span style="display:block; font-size:12px; color:var(--text-muted);">(jika dicentang, pindahkan status default dari wallet sebelumnya)</span>
              </label>
            </div>

            <!-- Modal Footer -->
            <div style="display:flex; justify-content:flex-end; align-items:center; gap:12px; border-top:1px solid #27272a; padding-top:16px;">
              <button type="button" class="btn btn-secondary" onclick="closeAddWalletModal()">Batal</button>
              <button type="submit" class="btn btn-primary">Simpan Wallet</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Toast Notifikasi Sukses -->
      <div id="walletToast" style="display:none; position:fixed; bottom:24px; right:24px; background:#18181b; border:1px solid rgba(249,115,22,0.5); box-shadow:0 10px 30px rgba(0,0,0,0.8), 0 0 15px rgba(249,115,22,0.2); color:#f4f4f5; padding:12px 18px; border-radius:10px; z-index:10000; align-items:center; gap:10px; font-size:13px; font-weight:600;">
        <span style="color:#22c55e; font-size:16px; line-height:1;">✓</span>
        <span id="walletToastMsg">Dompet berhasil ditambahkan!</span>
        <button type="button" onclick="document.getElementById('walletToast').style.display='none'" style="background:none; border:none; color:#a1a1aa; cursor:pointer; font-size:14px; padding:0 0 0 6px; line-height:1;" title="Tutup">✕</button>
      </div>

      <script>
        var toastTimer = null;

        function showWalletToast(msg) {
          var toast = document.getElementById('walletToast');
          var toastMsg = document.getElementById('walletToastMsg');
          if (toast && toastMsg) {
            toastMsg.innerText = msg;
            toast.style.display = 'flex';
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function() {
              toast.style.display = 'none';
            }, 3500);
          }
        }

        function openAddWalletModal() {
          var errorDiv = document.getElementById('modalErrorMsg');
          if (errorDiv) {
            errorDiv.style.display = 'none';
            errorDiv.innerText = '';
          }
          var modal = document.getElementById('addWalletModal');
          if (modal) {
            modal.style.display = 'flex';
          }
          var nameInput = document.getElementById('walletName');
          if (nameInput) {
            setTimeout(function() { nameInput.focus(); }, 50);
          }
        }

        function closeAddWalletModal() {
          var modal = document.getElementById('addWalletModal');
          if (modal) {
            modal.style.display = 'none';
          }
          var errorDiv = document.getElementById('modalErrorMsg');
          if (errorDiv) {
            errorDiv.style.display = 'none';
            errorDiv.innerText = '';
          }
          var nameInput = document.getElementById('walletName');
          var typeSelect = document.getElementById('walletType');
          var balanceInput = document.getElementById('walletBalance');
          var noteInput = document.getElementById('walletNote');
          var isDefaultCheck = document.getElementById('walletIsDefault');
          if (nameInput) nameInput.value = '';
          if (balanceInput) balanceInput.value = '';
          if (noteInput) noteInput.value = '';
          if (isDefaultCheck) isDefaultCheck.checked = false;
          if (typeSelect) typeSelect.selectedIndex = 0;
        }

        function formatRupiahInput(input) {
          var raw = input.value.replace(/[^0-9]/g, '');
          if (!raw) {
            input.value = '';
            return;
          }
          var num = parseInt(raw, 10);
          input.value = 'Rp ' + num.toLocaleString('id-ID');
        }

        function setDefaultWallet(el) {
          var card = el.closest('.card');
          if (!card) return;
          var allCards = document.querySelectorAll('#walletCardsGrid .card');
          allCards.forEach(function(c) {
            c.style.borderColor = 'var(--border-dark)';
            var b = c.querySelector('.badge');
            if (b) {
              b.className = 'badge badge-green';
              b.innerText = 'Aktif';
              b.style.cursor = 'pointer';
              b.title = 'Klik untuk jadikan default Telegram';
              b.setAttribute('onclick', 'setDefaultWallet(this)');
            }
            var noteDiv = c.querySelector('div[data-role="note"]');
            if (noteDiv && noteDiv.innerText.indexOf('Dipakai otomatis') !== -1) {
              noteDiv.innerText = 'E-Wallet / Dompet Sekunder';
            }
          });
          card.style.borderColor = 'var(--primary-orange)';
          var badge = card.querySelector('.badge');
          if (badge) {
            badge.className = 'badge badge-orange';
            badge.innerText = '★ DEFAULT TELEGRAM';
            badge.style.cursor = 'default';
            badge.title = '';
            badge.removeAttribute('onclick');
          }
          var noteDiv = card.querySelector('div[data-role="note"]');
          if (noteDiv && (noteDiv.innerText === 'E-Wallet / Dompet Sekunder' || !noteDiv.innerText)) {
            noteDiv.innerText = 'Dipakai otomatis saat input bot tanpa opsi dompet';
          }
          var nameEl = card.querySelector('div[data-role="name"]');
          var name = nameEl ? nameEl.innerText : 'Dompet';
          showWalletToast('Dompet "' + name + '" dijadikan default untuk Telegram!');
        }

        function submitAddWallet() {
          var nameInput = document.getElementById('walletName');
          var typeSelect = document.getElementById('walletType');
          var balanceInput = document.getElementById('walletBalance');
          var noteInput = document.getElementById('walletNote');
          var isDefaultCheck = document.getElementById('walletIsDefault');
          var errorDiv = document.getElementById('modalErrorMsg');

          var name = nameInput.value.trim();
          var type = typeSelect.value;
          var balanceDigits = balanceInput.value.replace(/[^0-9]/g, '');
          var note = noteInput.value.trim();
          var isDefault = isDefaultCheck.checked;

          if (!name) {
            errorDiv.innerText = 'Nama Wallet / Akun wajib diisi.';
            errorDiv.style.display = 'block';
            nameInput.focus();
            return;
          }

          if (!balanceDigits) {
            errorDiv.innerText = 'Saldo Awal wajib diisi.';
            errorDiv.style.display = 'block';
            balanceInput.focus();
            return;
          }

          errorDiv.style.display = 'none';
          var balanceNum = parseInt(balanceDigits, 10);
          var formattedBalance = 'Rp ' + balanceNum.toLocaleString('id-ID');

          // Determine Icon
          var icon = '👛';
          if (type === 'Bank Rekening') icon = '🏦';
          else if (type === 'E-Wallet') icon = '📱';
          else if (type === 'Dompet Kas / Tunai') icon = '💵';
          else icon = '💼';

          // If default selected, transfer default status from existing default wallet
          if (isDefault) {
            var allCards = document.querySelectorAll('#walletCardsGrid .card');
            allCards.forEach(function(c) {
              var badge = c.querySelector('.badge');
              if (badge && badge.innerText.indexOf('DEFAULT') !== -1) {
                c.style.borderColor = 'var(--border-dark)';
                badge.className = 'badge badge-green';
                badge.innerText = 'Aktif';
                badge.style.cursor = 'pointer';
                badge.title = 'Klik untuk jadikan default Telegram';
                badge.setAttribute('onclick', 'setDefaultWallet(this)');
                var noteDiv = c.querySelector('div[data-role="note"]');
                if (noteDiv && noteDiv.innerText.indexOf('Dipakai otomatis') !== -1) {
                  noteDiv.innerText = 'E-Wallet / Dompet Sekunder';
                }
              }
            });
          }

          // Build dynamic card
          var newCard = document.createElement('div');
          newCard.className = 'card';
          if (isDefault) {
            newCard.style.borderColor = 'var(--primary-orange)';
          }

          var badgeHtml = isDefault 
            ? '<span class="badge badge-orange">★ DEFAULT TELEGRAM</span>' 
            : '<span class="badge badge-green" onclick="setDefaultWallet(this)" style="cursor:pointer;" title="Klik untuk jadikan default Telegram">Aktif</span>';

          var noteHtml = note || (isDefault ? 'Dipakai otomatis saat input bot tanpa opsi dompet' : type);

          newCard.innerHTML = 
            '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">' +
              '<span style="font-size: 24px;">' + icon + '</span>' +
              badgeHtml +
            '</div>' +
            '<div data-role="name" style="font-size: 14px; color: var(--text-secondary);">' + escapeHtml(name) + '</div>' +
            '<div style="font-size: 28px; font-weight: 800; color: var(--text-primary); margin: 8px 0;">' + formattedBalance + '</div>' +
            '<div data-role="note" style="font-size: 12px; color: var(--text-muted);">' + escapeHtml(noteHtml) + '</div>';

          var grid = document.getElementById('walletCardsGrid');
          if (grid) {
            if (isDefault) {
              grid.insertBefore(newCard, grid.firstChild);
            } else {
              grid.appendChild(newCard);
            }
          }

          // Update transfer dropdown options
          var fromSelect = document.getElementById('transferFromSelect');
          var toSelect = document.getElementById('transferToSelect');
          [fromSelect, toSelect].forEach(function(sel) {
            if (sel) {
              var opt = document.createElement('option');
              opt.value = name;
              opt.innerText = name + ' (' + formattedBalance + ')';
              sel.appendChild(opt);
            }
          });

          // Reset form fields and close modal
          closeAddWalletModal();

          // Show Toast notification
          showWalletToast('Dompet "' + name + '" berhasil ditambahkan!');
        }

        function escapeHtml(str) {
          if (!str) return '';
          return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        // Close on backdrop click
        window.addEventListener('click', function(e) {
          var modal = document.getElementById('addWalletModal');
          if (e.target === modal) {
            closeAddWalletModal();
          }
        });

        // Close on Esc key
        window.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            closeAddWalletModal();
          }
        });
      </script>
"""
            self.send_html(render_layout("Multi-Wallet", content, "wallets"))
            return

        # -------------------------------------------------------------
        # 5. BUDGETS (/dashboard/budgets)
        # -------------------------------------------------------------
        elif path == "/dashboard/budgets":
            content = """
