      font-size: 56px;
      font-weight: 800;
      line-height: 1.15;
      color: var(--text-primary);
      margin: 20px 0;
      letter-spacing: -0.02em;
    }}
    .orange-gradient {{
      background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }}
    .lead-text {{
      font-size: 20px;
      color: var(--text-secondary);
      max-width: 760px;
      margin: 0 auto 40px;
      line-height: 1.6;
    }}
    .btn-hero-group {{
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-bottom: 50px;
    }}
    .section-title {{
      font-size: 32px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 16px;
      color: var(--text-primary);
    }}
    .section-sub {{
      text-align: center;
      color: var(--text-secondary);
      max-width: 650px;
      margin: 0 auto 50px;
      font-size: 16px;
    }}
    .grid-3 {{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      max-width: 1100px;
      margin: 0 auto 80px;
      padding: 0 24px;
    }}
    .chat-simulator {{
      background: #121215;
      border: 1px solid var(--border-dark);
      border-radius: 16px;
      max-width: 600px;
      margin: 0 auto 80px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }}
    .chat-header {{
      background: #18181c;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-dark);
      display: flex;
      align-items: center;
      gap: 12px;
    }}
    .chat-body {{
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      background: #09090b;
    }}
    .msg {{
      max-width: 80%;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 14px;
      line-height: 1.5;
    }}
    .msg-user {{
      align-self: flex-end;
      background: #f97316;
      color: #ffffff;
      border-bottom-right-radius: 2px;
    }}
    .msg-bot {{
      align-self: flex-start;
      background: #18181b;
      color: #f4f4f5;
      border: 1px solid var(--border-dark);
      border-bottom-left-radius: 2px;
      white-space: pre-wrap;
    }}
    .pricing-grid {{
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      max-width: 850px;
      margin: 0 auto 80px;
      padding: 0 24px;
    }}
    .pricing-card {{
      background: var(--card-dark);
      border: 1px solid var(--border-dark);
      border-radius: 16px;
      padding: 36px;
      display: flex;
      flex-direction: column;
      position: relative;
    }}
    .pricing-card.featured {{
      border-color: var(--primary-orange);
      background: linear-gradient(180deg, rgba(249, 115, 22, 0.12) 0%, #121215 100%);
    }}
    .footer-grid {{
      border-top: 1px solid var(--border-dark);
      padding: 60px 40px;
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      color: var(--text-secondary);
      font-size: 14px;
    }}
  </style>
</head>
<body>
  <nav class="landing-nav">
    <div style="font-size: 22px; font-weight: 800; color: #f4f4f5;">
      ⚡ Tata<span style="color:#f97316;">Dana</span>
    </div>
    <div style="display:flex; gap: 20px; align-items: center;">
      <a href="#fitur" style="color:var(--text-secondary);">Fitur</a>
      <a href="#demo" style="color:var(--text-secondary);">Simulator Bot</a>
      <a href="#harga" style="color:var(--text-secondary);">Harga</a>
      <div id="landingAuthActions" style="display:inline-flex; gap: 10px; align-items: center;">
        <button type="button" onclick="openLandingLoginModal(event)" class="btn btn-secondary">Masuk</button>
        <a href="/register" class="btn btn-primary">Mulai Gratis Sekarang &rarr;</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="badge badge-orange">✨ Catat keuangan langsung dari Telegram</div>
    <h1 class="headline">Gaji habis sebelum akhir bulan? Sudah saatnya kamu tahu <span class="orange-gradient">ke mana uangmu pergi.</span></h1>
    <p class="lead-text">TataDana mencatat setiap pengeluaranmu langsung dari chat Telegram atau foto struk — sisanya kami yang urus dengan AI otomatis.</p>
    <div class="btn-hero-group">
      <a href="/register" class="btn btn-primary" style="font-size:16px; padding:14px 28px;">Mulai Gratis Sekarang</a>
      <button type="button" onclick="openLandingLoginModal(event)" class="btn btn-secondary" style="font-size:16px; padding:14px 28px;">Masuk ke Akun &rarr;</button>
    </div>
  </section>

  <!-- Interactive Simulator Section -->
  <section id="demo" style="padding: 20px 24px;">
    <h2 class="section-title">Simulator Interaktif Telegram Bot</h2>
    <p class="section-sub">Ketik bahasa sehari-hari orang Indonesia. AI kami otomatis mengenali nominal '15rb', '1.5jt', struk OCR, dan kategori.</p>
    <div class="chat-simulator">
      <div class="chat-header">
        <div style="width: 38px; height: 38px; border-radius: 50%; background: #f97316; display: flex; align-items: center; justify-content: center; font-weight: 800; color:var(--text-primary);">TD</div>
        <div>
          <div style="font-weight: 700; color:var(--text-primary); font-size: 15px;">TataDana Bot</div>
          <div style="font-size: 12px; color: #22c55e;">● Bot Online (WIB)</div>
        </div>
      </div>
      <div class="chat-body" id="chatContainer">
        <div class="msg msg-user">beli kopi susu gula aren 18rb</div>
        <div class="msg msg-bot">📅 Minggu, 11 Okt 2026 — 10:15 WIB
💸 Pengeluaran tercatat!
├ Nominal : Rp 18.000
├ Kategori : 🍜 Makanan & Minuman
├ Dompet : 👛 GoPay
├ Catatan : beli kopi susu gula aren 18rb
└ Saldo : Rp 1.482.000

📊 Budget Makanan bulan ini:
████████░░ 78% — sisa Rp 420.000
💡 Tips: Pengeluaran makanan terkendali dengan baik minggu ini.</div>
        <div class="msg msg-user">gajian pt finansial 25jt</div>
        <div class="msg msg-bot">📅 Minggu, 11 Okt 2026 — 10:16 WIB
💰 Pemasukan tercatat!
├ Nominal : Rp 25.000.000
├ Kategori : 💼 Gaji & Pendapatan
├ Dompet : 👛 BCA
└ Saldo baru : Rp 32.750.000

💪 Semangat terus! Jangan lupa sisihkan untuk tabungan & investasi ya.</div>
