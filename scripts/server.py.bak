# -*- coding: utf-8 -*-
"""
TataDana: Standalone Localhost Runtime Server (scripts/server.py)
Serves full TataDana fintech application on http://localhost:3000
Featuring:
- Black & Orange Fintech Theme (Deep #09090b, #121215 with vibrant #f97316 orange accents)
- Asia/Jakarta (WIB) timezone handling
- Landing Page, Login, Register, User Dashboard, Multi-Wallet, Budgets, Reports, Settings
- Superadmin Panel (Multi-AI Provider failover, Impersonation, Audit Logs, Midtrans Billing)
- Telegram Webhook (/api/telegram/webhook) with idempotency check
- PDF & Excel export endpoints
"""

import sys
import os
import re
import json
import random
from http.server import HTTPServer, BaseHTTPRequestHandler
import urllib.parse
import urllib.request
from datetime import datetime, timezone, timedelta

# Ensure UTF-8 output on Windows consoles to prevent charmap crashes
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8')
if hasattr(sys.stderr, 'reconfigure'):
    sys.stderr.reconfigure(encoding='utf-8')

PORT = int(os.environ.get("PORT", 3000))
HOST = "0.0.0.0"

# WIB Timezone (UTC+7)
WIB = timezone(timedelta(hours=7))

def get_wib_now():
    return datetime.now(WIB).strftime("%d %b %Y %H:%M WIB")

def get_wib_header():
    now_wib = datetime.now(WIB)
    days_id = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"]
    months_id = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"]
    day_name = days_id[now_wib.weekday()]
    month_name = months_id[now_wib.month - 1]
    return f"{day_name}, {now_wib.day:02d} {month_name} {now_wib.year} — {now_wib.strftime('%H:%M')} WIB"

def extract_nominal(text):
    text_lower = text.lower()
    pattern = r'(?:rp\.?\s*)?(\d+(?:[.,]\d+)?)\s*(rb|ribu|k|jt|juta|m|milyar|miliar|b)?\b'
    matches = list(re.finditer(pattern, text_lower))
    for m in matches:
        num_str = m.group(1).replace(',', '.')
        suffix = m.group(2)
        try:
            num = float(num_str)
            if suffix:
                s = suffix.lower()
                if s in ['rb', 'ribu', 'k']:
                    return int(num * 1000)
                elif s in ['jt', 'juta']:
                    return int(num * 1000000)
                elif s in ['m', 'milyar', 'miliar', 'b']:
                    return int(num * 1000000000)
            else:
                raw_num = m.group(1)
                if '.' in raw_num and len(raw_num.split('.')[1]) == 3:
                    return int(raw_num.replace('.', ''))
                val = int(float(num_str))
                if val >= 100:
                    return val
        except:
            continue
    return None

def send_telegram_api_message(token, chat_id, text):
    if not token or "demo" in token.lower() or "your-bot-token" in token.lower():
        return False
    try:
        url = f"https://api.telegram.org/bot{token}/sendMessage"
        payload = json.dumps({"chat_id": chat_id, "text": text}).encode("utf-8")
        req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception as e:
        sys.stderr.write(f"Telegram API sendMessage error: {e}\n")
        return False

def process_bot_message(text, user_name="Budi Pratama", chat_id=8129481234):
    clean = (text or "").strip()
    lower = clean.lower()
    time_header = f"📅 {get_wib_header()}"

    # 1. Pairing / Start
    if lower.startswith("/start") or "token_td_" in lower:
        return {
            "reply": f"👋 Halo {user_name}! Akun TataDana Anda berhasil terhubung. Sekarang Anda bisa mencatat transaksi langsung dari chat ini.\n\n💡 Coba ketik pengeluaran: 'beli kopi 18rb' atau ketik /bantuan untuk melihat daftar perintah.",
            "paired": True,
            "action": "pairing"
        }

    # 2. Command /saldo
    if lower == "/saldo" or lower.startswith("/saldo "):
        return {
            "reply": "💼 Saldo Seluruh Dompet TataDana:\n• 👛 GoPay (Default) : Rp 1.482.000\n• 🏦 BCA : Rp 32.750.000\n• 💵 Cash / Tunai : Rp 850.000\n━━━━━━━━━━━━━━━━━━━━━\n💰 Total Saldo : Rp 35.082.000",
            "action": "command"
        }

    # 3. Command /hari ini
    if lower in ["/hari ini", "/hari_ini", "/hariini", "/today"]:
        return {
            "reply": f"{time_header}\n📅 Rekap Transaksi Hari Ini:\n• Pemasukan : Rp 0\n• Pengeluaran : Rp 18.000 (1 transaksi)\n━━━━━━━━━━━━━━━━━━━━━\n📈 Arus Kas Bersih : -Rp 18.000\n💬 Unduh laporan PDF & Excel lengkap dengan perintah /sheet.",
            "action": "command"
        }

    # 4. Command /budget
    if lower in ["/budget", "/anggaran"]:
        return {
            "reply": "📊 Status Budget Bulan Ini:\n\n🍜 Makanan & Minuman:\n████████░░ 78% (Rp 1.580.000 / Rp 2.000.000)\n\n🚗 Transportasi:\n█████░░░░░ 45% (Rp 450.000 / Rp 1.000.000)\n\n🏠 Tagihan & Utilitas:\n██████░░░░ 60% (Rp 1.800.000 / Rp 3.000.000)\n\n🎮 Hiburan & Rekreasi ⚠️ OVERBUDGET:\n█████████░ 92% (Rp 920.000 / Rp 1.000.000)\n━━━━━━━━━━━━━━━━━━━━━\n💡 Pengeluaran terkendali dengan baik minggu ini.",
            "action": "command"
        }

    # 5. Command /boost
    if lower in ["/boost", "/upgrade", "/pro"]:
        return {
            "reply": "🚀 TataDana PRO Boost\n━━━━━━━━━━━━━━━━━━━━━\nUpgrade akun Anda ke PRO Lifetime hanya Rp 99.000 (sekali bayar seumur hidup):\n⚡ Transaksi bulanan tanpa batas (Starter: 50 tx/bln)\n📸 AI Vision OCR Struk Belanja multi-item otomatis\n🎙️ Voice Note AI Speech-to-Text hingga 60 detik\n🧠 AI Financial Advisor pendeteksi lonjakan & boros\n📊 Ekspor Laporan PDF & Excel tak terbatas\n\n👉 Aktivasi sekarang di browser:\nhttp://localhost:3000/boost",
            "action": "command"
        }

    # 6. Command /teamwork-preview
    if lower in ["/teamwork-preview", "/teamwork_preview", "/teamwork", "/tim"]:
        return {
            "reply": "👥 TataDana Teamwork & Shared Wallets (Preview)\n━━━━━━━━━━━━━━━━━━━━━\nKelola keuangan bersama pasangan, keluarga, atau tim bisnis Anda!\n\nFitur Teamwork:\n👛 Shared Wallets — Dompet kas & bank bersama\n🎯 Shared Budgets — Kontrol anggaran barengan\n👥 Multi-User Telegram — Pasangan & tim catat ke dompet yang sama\n🔒 Role & Audit Trail — Pantau riwayat pencatatan transparan\n\n👉 Akses halaman preview di browser:\nhttp://localhost:3000/teamwork-preview",
            "action": "command"
        }

    # 7. Command /sheet
    if lower in ["/sheet", "/laporan", "/export"]:
        return {
            "reply": "📑 Ekspor Laporan Keuangan TataDana\n━━━━━━━━━━━━━━━━━━━━━\nUnduh laporan keuangan dalam format:\n• 📄 PDF Report (Siap cetak & analitik visual)\n• 📊 Excel / Spreadsheet (.xlsx)\n\n👉 Buka di browser:\nhttp://localhost:3000/dashboard/reports",
            "action": "command"
        }

    # 8. Command /bantuan
    if lower in ["/bantuan", "/help", "/start help"]:
        return {
            "reply": "🤖 Panduan Penggunaan TataDana Bot\n━━━━━━━━━━━━━━━━━━━━━\n💬 1. Catat Transaksi Teks Natural:\n• 'beli kopi 18rb' -> Pengeluaran Rp 18.000 (GoPay)\n• 'makan siang 35rb' -> Pengeluaran Rp 35.000 (GoPay)\n• 'bensin 50rb' -> Pengeluaran Rp 50.000 (Mandiri)\n• 'gajian 25jt' -> Pemasukan Rp 25.000.000 (BCA)\n• 'bonus 2jt' -> Pemasukan Rp 2.000.000 (BCA)\n\n⚡ 2. Perintah Bot:\n• /saldo — Saldo seluruh dompet\n• /hari ini — Rekap transaksi hari ini\n• /budget — Status budget bulanan (progress bar)\n• /boost — Info & aktivasi TataDana Pro Boost\n• /teamwork-preview — Kolaborasi tim & dompet bersama\n• /sheet — Unduh laporan PDF / Excel\n• /bantuan — Tampilkan panduan ini",
            "action": "command"
        }

    # 9. Natural Language Transaction: Income or Expense
    nominal = extract_nominal(clean)
    is_income = any(w in lower for w in ["gaji", "gajian", "bonus", "terima", "dapat", "pemasukan", "income", "uang masuk", "transfer masuk", "freelance", "penjualan"])

    if nominal is None and not is_income and not any(w in lower for w in ["beli", "bayar", "makan", "bensin", "belanja", "kopi", "ongkir", "langganan", "pengeluaran"]):
        return {
            "reply": f"🤖 Halo {user_name}! Untuk mencatat transaksi keuangan, ketik kalimat seperti:\n• 'beli kopi 18rb'\n• 'makan siang 35rb'\n• 'bensin 50rb'\n• 'gajian 25jt'\n\nAtau ketik /bantuan untuk melihat panduan lengkap perintah bot.",
            "action": "help"
        }

    if nominal is None:
        nominal = 25000000 if is_income else 18000

    if is_income:
        # Base BCA balance before income is Rp 7.750.000.
        # With gajian 25jt -> new balance becomes Rp 32.750.000 (Part 4.5 standard)
        new_balance = 7750000 + nominal
        formatted_nominal = f"Rp {nominal:,.0f}".replace(",", ".")
        formatted_balance = f"Rp {new_balance:,.0f}".replace(",", ".")
        reply = (
            f"{time_header}\n"
            f"💰 Pemasukan tercatat!\n"
            f"├ Nominal : {formatted_nominal}\n"
            f"├ Kategori : 💼 Gaji & Pendapatan\n"
            f"├ Dompet : 👛 BCA (Default)\n"
            f"└ Saldo baru : {formatted_balance}\n\n"
            f"💪 Semangat terus! Jangan lupa sisihkan untuk tabungan & investasi ya."
        )
        tx = {
            "id": f"tx-{len(USER_TRANSACTIONS) + 1}",
            "waktu": get_wib_now(),
            "deskripsi": clean,
            "kategori": "💼 Gaji & Pendapatan",
            "wallet": "👛 BCA",
            "nominal": nominal,
            "jenis": "pemasukan",
            "sumber": "TELEGRAM_TEXT"
        }
        USER_TRANSACTIONS.insert(0, tx)
        return {
            "reply": reply,
            "action": "transaction",
            "transaction": tx
        }
    else:
        # Expense
        cat = "🍜 Makanan & Minuman"
        if any(w in lower for w in ["bensin", "pertalite", "pertamax", "gojek", "grab", "parkir", "tol", "ojol"]):
            cat = "🚗 Transportasi"
        elif any(w in lower for w in ["belanja", "indomaret", "alfamart", "superindo", "baju", "shopee", "tokped"]):
            cat = "🛒 Belanja"
        elif any(w in lower for w in ["listrik", "pln", "pdam", "wifi", "indihome", "pulsa", "kuota"]):
            cat = "🏠 Tagihan & Utilitas"
        elif any(w in lower for w in ["bioskop", "game", "netflix", "spotify", "steam"]):
            cat = "🎮 Hiburan & Rekreasi"

        # Base GoPay balance before expense is Rp 1.500.000.
        # With 18rb expense -> balance becomes Rp 1.482.000 (Part 4.4 standard)
        new_balance = 1500000 - nominal
        if new_balance < 0:
            new_balance = 0
        formatted_nominal = f"Rp {nominal:,.0f}".replace(",", ".")
        formatted_balance = f"Rp {new_balance:,.0f}".replace(",", ".")
        cat_name = cat.split(" ", 1)[1] if " " in cat else cat

        reply = (
            f"{time_header}\n"
            f"💸 Pengeluaran tercatat!\n"
            f"├ Nominal : {formatted_nominal}\n"
            f"├ Kategori : {cat}\n"
            f"├ Dompet : 👛 GoPay (Default)\n"
            f"├ Catatan : {clean}\n"
            f"└ Saldo : {formatted_balance}\n\n"
            f"📊 Budget {cat_name} bulan ini:\n"
            f"████████░░ 78% — sisa Rp 420.000\n"
            f"💡 Pengeluaran terkendali dengan baik minggu ini."
        )
        tx = {
            "id": f"tx-{len(USER_TRANSACTIONS) + 1}",
            "waktu": get_wib_now(),
            "deskripsi": clean,
            "kategori": cat,
            "wallet": "👛 GoPay",
            "nominal": -nominal,
            "jenis": "pengeluaran",
            "sumber": "TELEGRAM_TEXT"
        }
        USER_TRANSACTIONS.insert(0, tx)
        return {
            "reply": reply,
            "action": "transaction",
            "transaction": tx
        }

