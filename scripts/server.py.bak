        <div class="card">
          <div style="font-size:13px; color:var(--text-secondary);">Net Cashflow</div>
          <div style="font-size:24px; font-weight:700; color:var(--text-primary);">+Rp 15.750.000</div>
        </div>
      </div>

      <!-- Transactions Table -->
      <div class="card">
        <h3 style="margin-top:0; color:var(--text-primary);">Data Transaksi Lengkap (Realtime WIB)</h3>
        <table>
          <thead>
