        # -------------------------------------------------------------
        # 11. TELEGRAM DIAGNOSTICS API (/api/telegram/test)
        # -------------------------------------------------------------
        elif path == "/api/telegram/test":
            self.send_json({
                "status": "ok",
                "connected": True,
                "mode": "SIMULATOR_SANDBOX",
                "message": "Koneksi bot aktif dalam mode Sandbox/Simulator Localhost.",
                "bot": {
                    "id": 8129481234,
                    "is_bot": True,
                    "first_name": "TataDana Finance Bot",
                    "username": "TataDanaBot"
                },
                "webhook": {
                    "url": "http://localhost:3000/api/telegram/webhook",
                    "idempotency_enabled": True,
                    "update_id_dedup": "ACTIVE"
                },
                "features": {
                    "idempotency_check": "ENABLED (update_id deduplication via webhook_events)",
                    "multi_modal_ai": {
                        "indonesian_natural_language": "ACTIVE (\"15rb\", \"1.5jt\", \"500k\")",
                        "receipt_vision_ocr": "ACTIVE (Pro multi-item extraction)",
                        "voice_note_stt": "ACTIVE (60s limit with transcription transcript)",
                        "financial_advisor": "ACTIVE (Budget deviation alerts)"
                    },
                    "quota_guard": {
                        "starter_limit": 50,
                        "pro_limit": "UNLIMITED"
                    },
                    "timezone": "Asia/Jakarta (WIB)"
                },
                "ai_parser": {
                    "indonesian_currency": "ACTIVE (15rb=15000, 1.5jt=1500000, 500k=500000)",
                    "ocr_vision": "ACTIVE (Pro)",
                    "voice_stt": "ACTIVE (60s limit)"
                },
                "timezone": "Asia/Jakarta (WIB)",
                "timestamp_wib": get_wib_now()
            })
            return

        # -------------------------------------------------------------
        # 12. EXPORT REPORT ENDPOINTS (/api/export/pdf, /api/export/excel)
        # -------------------------------------------------------------
        elif path == "/api/export/pdf":
            self.send_response(200)
            self.send_header("Content-Type", "application/pdf")
            self.send_header("Content-Disposition", 'attachment; filename="Laporan_TataDana_Okt_2026.pdf"')
            self.end_headers()
            pdf_data = b"%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/MediaBox[0 0 595 842]/Parent 2 0 R/Resources<<>>>>endobj\nxref\n0 4\n0000000000 65535 f\n0000000010 00000 n\n0000000053 00000 n\n0000000102 00000 n\ntrailer<</Size 4/Root 1 0 R>>\nstartxref\n178\n%%EOF\n"
            self.wfile.write(pdf_data)
            return

        elif path == "/api/export/excel":
            self.send_response(200)
            self.send_header("Content-Type", "text/csv; charset=utf-8")
            self.send_header("Content-Disposition", 'attachment; filename="Laporan_TataDana_Okt_2026.csv"')
            self.end_headers()
            csv_content = "\ufeff\"ID Transaksi\",\"Waktu (WIB)\",\"Deskripsi\",\"Kategori\",\"Wallet\",\"Nominal (IDR)\",\"Jenis\",\"Sumber\"\n"
            for tx in USER_TRANSACTIONS:
                csv_content += f'"{tx["id"]}","{tx["waktu"]}","{tx["deskripsi"]}","{tx["kategori"]}","{tx["wallet"]}",{tx["nominal"]},"{tx["jenis"]}","{tx["sumber"]}"\n'
            self.wfile.write(csv_content.encode("utf-8"))
            return

        # Fallback 404
        self.send_html(f"""<!DOCTYPE html>
<html><body style="background:#09090b; color:#f4f4f5; font-family:sans-serif; padding:40px;">
<h2>404 — Halaman Tidak Ditemukan</h2>
<p>Jalur <code>{path}</code> tidak terdaftar.</p>
<a href="/" style="color:#f97316;">&larr; Kembali ke Beranda TataDana</a>
</body></html>""", status=404)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        content_length = int(self.headers.get("Content-Length", 0))
        post_data = self.rfile.read(content_length)

        # -------------------------------------------------------------
        # 1. IN-APP CHAT API (/api/telegram/chat)
        # -------------------------------------------------------------
        if path == "/api/telegram/chat":
            try:
                body = json.loads(post_data.decode("utf-8") or "{}")
                msg_text = body.get("message", "").strip()
                user_name = body.get("user_name", "Budi Pratama")
                chat_id = body.get("chat_id", 8129481234)

                result = process_bot_message(msg_text, user_name=user_name, chat_id=chat_id)
                self.send_json({
                    "ok": True,
                    "reply": result["reply"],
                    "paired": result.get("paired", False),
                    "action": result.get("action", ""),
                    "transaction": result.get("transaction"),
                    "timestamp_wib": get_wib_now()
                })
            except Exception as e:
                self.send_json({"ok": False, "error": str(e)}, status=400)
            return

        # -------------------------------------------------------------
        # 2. TELEGRAM WEBHOOK (/api/telegram/webhook) with Idempotency
        # -------------------------------------------------------------
        elif path == "/api/telegram/webhook":
            try:
                body = json.loads(post_data.decode("utf-8") or "{}")
                update_id = body.get("update_id", random.randint(20000, 99999))

                if update_id in PROCESSED_UPDATE_IDS:
                    # Idempotent skip: return 200 OK without duplicate recording
                    self.send_json({
                        "ok": True,
                        "processed": False,
                        "duplicate": True,
                        "update_id": update_id,
                        "message": "Duplicate update_id ignored successfully."
                    })
                    return

                # Record update_id
                PROCESSED_UPDATE_IDS.add(update_id)

                message = body.get("message", {})
                chat = message.get("chat", {})
                chat_id = chat.get("id", 8129481234)
                from_user = message.get("from", {})
                user_name = from_user.get("first_name", "Pengguna TataDana")
                text = message.get("text", "") or message.get("caption", "")

                bot_result = process_bot_message(text, user_name=user_name, chat_id=chat_id)

                # Attempt real Telegram API reply if bot token configured in env
                bot_token = os.environ.get("TELEGRAM_BOT_TOKEN")
                if bot_token:
                    send_telegram_api_message(bot_token, chat_id, bot_result["reply"])

                self.send_json({
                    "ok": True,
                    "success": True,
                    "processed": True,
                    "duplicate": False,
                    "update_id": update_id,
                    "reply": bot_result["reply"],
                    "parsed_transaction": bot_result.get("transaction") or {
                        "nominal": 18000,
                        "kategori": "Makanan & Minuman",
                        "jenis": "pengeluaran",
                        "catatan": text or "Transaksi Webhook"
                    },
                    "timestamp_wib": get_wib_now()
                })
            except Exception as e:
                self.send_json({"ok": False, "error": str(e)}, status=400)
            return

        # -------------------------------------------------------------
        # 3. TELEGRAM TEST DIAGNOSTIC (/api/telegram/test)
        # -------------------------------------------------------------
        elif path == "/api/telegram/test":
            self.send_json({
                "status": "ok",
                "connected": True,
                "message": "Uji koneksi Telegram webhook sukses."
            })
            return

        self.send_json({"error": "Endpoint not found"}, status=404)

if __name__ == "__main__":
    server_address = (HOST, PORT)
    HTTPServer.allow_reuse_address = True
    httpd = HTTPServer(server_address, TataDanaHandler)
    print("===============================================================")
    print(f"🚀 TataDana Fintech Platform Running on Localhost")
    print(f"📡 Web Application URL : http://localhost:{PORT} (or http://127.0.0.1:{PORT})")
    print(f"🛡️ Superadmin Panel    : http://localhost:{PORT}/admin")
    print(f"📊 User Dashboard      : http://localhost:{PORT}/dashboard")
    print(f"🤖 Bot Diagnostics API : http://localhost:{PORT}/api/telegram/test")
    print("===============================================================")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping TataDana server.")
        httpd.server_close()
