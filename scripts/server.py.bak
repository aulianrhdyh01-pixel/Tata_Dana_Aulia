        # -------------------------------------------------------------
        # 7. SETTINGS & BOT SETUP (/dashboard/settings)
        # -------------------------------------------------------------
        elif path == "/dashboard/settings":
            import random
            rand_token = f"/start token_td_{random.randint(100000, 999999)}"
            content = f"""
      <div class="topbar">
        <div>
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
            <span class="badge badge-orange" style="font-size:11px; padding:3px 10px;">⚙️ Pengaturan & Bot</span>
            <span style="font-size:12px; color:var(--text-muted);">● Asia/Jakarta (WIB)</span>
          </div>
          <h1 class="page-title">Integrasi Bot Telegram</h1>
          <p class="page-sub">Hubungkan akun TataDana Anda ke bot Telegram untuk mulai mencatat keuangan instan via chat.</p>
        </div>
        <div style="display:flex; gap:12px; align-items:center;">
          <a href="/dashboard" class="btn btn-secondary">🏠 Beranda Overview</a>
        </div>
      </div>

      <!-- LANGKAH 1 -->
      <div class="card" style="margin-bottom: 24px; background: #18181b; border: 1px solid #27272a; border-radius: 14px; padding: 24px;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
          <span style="background: rgba(249, 115, 22, 0.15); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.35); font-weight:800; font-size:12px; padding:4px 10px; border-radius:6px;">Langkah 1</span>
          <h3 style="margin:0; font-size:17px; font-weight:700; color:var(--text-primary);">Hubungi Bot Telegram Resmi</h3>
        </div>
        <p style="color:var(--text-secondary); font-size:14px; line-height:1.6; margin:0 0 18px;">
          Hubungi bot Telegram resmi TataDana dengan mengeklik tombol oranye besar di bawah ini. Tombol ini akan membuka tautan eksternal ke Telegram bot resmi <strong>@TataDanaBot</strong>.
        </p>
        <div>
          <a href="https://t.me/TataDanaBot" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding:14px 28px; font-size:15px; font-weight:700; border-radius:10px; text-decoration:none; display:inline-flex; align-items:center; gap:10px; box-shadow: 0 4px 14px rgba(249, 115, 22, 0.35);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .36z"/></svg>
            Buka Bot Telegram (t.me/TataDanaBot)
          </a>
        </div>
      </div>

      <!-- LANGKAH 2 (Sistem Pairing / Token) -->
      <div class="card" style="margin-bottom: 24px; background: #18181b; border: 1px solid #27272a; border-radius: 14px; padding: 24px;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
          <span style="background: rgba(249, 115, 22, 0.15); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.35); font-weight:800; font-size:12px; padding:4px 10px; border-radius:6px;">Langkah 2</span>
          <h3 style="margin:0; font-size:17px; font-weight:700; color:var(--text-primary);">Sistem Pairing / Token</h3>
        </div>
        <div style="margin-bottom: 8px;">
          <label style="display:block; font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">
            Kode Token Aktivasi
          </label>
          <div style="display:flex; gap:12px; align-items:center; max-width:650px;">
            <div style="flex:1; background:#121215; border:1px solid #27272a; border-radius:10px; padding:14px 18px; display:flex; align-items:center;">
              <code id="tokenCodeBox" style="font-family:'Courier New', monospace; font-size:16px; font-weight:700; color:#f97316; letter-spacing:0.5px;">{rand_token}</code>
            </div>
            <button id="btnCopyToken" onclick="copyActivationToken()" class="btn btn-secondary" style="padding:14px 22px; font-weight:700; border-radius:10px; white-space:nowrap; background:#18181b; border:1px solid #27272a; display:inline-flex; align-items:center; gap:8px;">
              <span>📋</span> <span id="copyTokenText">Salin Kode</span>
            </button>
          </div>
        </div>
        <p style="margin:12px 0 0; color:var(--text-secondary); font-size:13px; line-height:1.5;">
          💬 <em>Kirimkan kode token di atas ke chat bot Telegram Anda atau coba langsung di Chat Interaktif di bawah!</em>
        </p>
      </div>

      <!-- LANGKAH 3 (Verifikasi Status) -->
      <div class="card" style="margin-bottom: 24px; background: #18181b; border: 1px solid #27272a; border-radius: 14px; padding: 24px;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
          <span style="background: rgba(249, 115, 22, 0.15); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.35); font-weight:800; font-size:12px; padding:4px 10px; border-radius:6px;">Langkah 3</span>
          <h3 style="margin:0; font-size:17px; font-weight:700; color:var(--text-primary);">Verifikasi Status Hubungan</h3>
        </div>
        <p style="color:var(--text-secondary); font-size:14px; line-height:1.6; margin:0 0 16px;">
          Setelah mengirimkan token ke chat bot Telegram atau chat interaktif di bawah, klik tombol verifikasi untuk menyinkronkan status pairing.
        </p>

        <!-- Status Container -->
        <div id="pairingStatusBox" style="margin-bottom:18px; padding:16px 20px; border-radius:10px; background:#121215; border:1px solid #27272a; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; transition:all 0.3s ease;">
          <div style="display:flex; align-items:center; gap:12px;">
            <div id="statusDot" style="width:12px; height:12px; border-radius:50%; background:#71717a; transition:all 0.3s ease;"></div>
            <div>
              <div id="statusMainText" style="font-size:14px; font-weight:700; color:var(--text-primary);">Status: Belum Terhubung</div>
              <div id="statusSubText" style="font-size:12px; color:var(--text-muted); margin-top:2px;">Kirim token di atas ke Telegram lalu klik Verifikasi Hubungan</div>
            </div>
          </div>
          <div id="badgeContainer">
            <span id="pairingBadge" class="badge" style="background:#27272a; color:#a1a1aa; border:1px solid #3f3f46;">Belum Diverifikasi</span>
          </div>
        </div>

        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
          <button id="btnVerifyConnection" class="btn btn-primary" onclick="verifyTelegramConnection()" style="padding:14px 26px; font-size:14px; font-weight:700; border-radius:10px; display:inline-flex; align-items:center; gap:8px;">
            <span id="verifyLoadingSpinner" style="display:none; animation: spin 1s linear infinite;">🔄</span>
            <span id="verifyButtonText">Verifikasi Hubungan</span>
          </button>
          <button id="btnDisconnect" class="btn btn-secondary" onclick="disconnectTelegramConnection()" style="display:none; padding:14px 22px; font-size:14px; font-weight:700; border-radius:10px; border-color:#ef4444; color:#ef4444 !important; background:rgba(239,68,68,0.1);">
            🔌 Putus Koneksi
          </button>
        </div>
      </div>

      <!-- CHAT INTERAKTIF TATADANA BOT -->
      <div class="card" style="margin-bottom: 24px; background: #121215; border: 1px solid #27272a; border-radius: 14px; padding: 24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg, #f97316, #ea580c); display:flex; align-items:center; justify-content:center; font-size:22px; box-shadow:0 0 14px rgba(249,115,22,0.4);">
              🤖
            </div>
            <div>
              <div style="display:flex; align-items:center; gap:8px;">
                <h3 style="margin:0; font-size:17px; font-weight:800; color:var(--text-primary);">💬 Chat Interaktif TataDana Bot</h3>
                <span class="badge badge-green" style="font-size:11px; padding:2px 8px;">● Online</span>
              </div>
              <p style="margin:3px 0 0; color:var(--text-muted); font-size:12px;">Ketik pesan di bawah dan bot akan membalas secara real-time. Transaksi otomatis tersimpan ke dashboard!</p>
            </div>
          </div>
          <div style="display:flex; gap:8px;">
            <span class="badge badge-orange" style="font-size:11px;">⚡ Multi-Modal AI & Webhook Sync</span>
          </div>
        </div>

        <!-- Chat Bubble Container -->
        <div id="interactiveChatBox" style="background:#09090b; border:1px solid #27272a; border-radius:12px; height:380px; overflow-y:auto; padding:20px; display:flex; flex-direction:column; gap:14px; scroll-behavior:smooth;">
          <!-- Welcome message from bot -->
          <div class="chat-msg bot-msg" style="align-self:flex-start; max-width:85%; background:#18181b; border:1px solid #27272a; border-radius:12px 12px 12px 2px; padding:14px 16px; color:#f4f4f5; font-size:13px; line-height:1.55; box-shadow:0 2px 8px rgba(0,0,0,0.4);">
            <div style="display:flex; align-items:center; gap:6px; font-size:11px; font-weight:700; color:#f97316; margin-bottom:6px;">
              <span>🤖 TataDana Bot</span>
              <span style="color:#71717a;">• Baru saja</span>
            </div>
            👋 <strong>Halo Sobat TataDana!</strong> Saya bot asisten keuangan cerdas Anda.<br><br>
            Untuk memulai, silakan kirimkan <strong>kode token pairing</strong> Anda atau langsung ketik transaksi seperti <code>beli kopi 18rb</code>, <code>gajian 25jt</code>, atau perintah <code>/bantuan</code>!
          </div>
        </div>

        <!-- Shortcut Quick Action Chips -->
        <div style="display:flex; gap:8px; overflow-x:auto; padding:12px 2px 6px; margin-top:8px;">
          <button type="button" onclick="sendQuickMessage('{rand_token}')" style="background:#18181b; border:1px solid #f97316; color:#f97316; font-size:11px; font-weight:700; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">📋 Token Pairing</button>
          <button type="button" onclick="sendQuickMessage('beli kopi 18rb')" style="background:#18181b; border:1px solid #27272a; color:#f4f4f5; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">☕ Beli Kopi 18rb</button>
          <button type="button" onclick="sendQuickMessage('makan siang 35rb')" style="background:#18181b; border:1px solid #27272a; color:#f4f4f5; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">🍜 Makan Siang 35rb</button>
          <button type="button" onclick="sendQuickMessage('bensin 50rb')" style="background:#18181b; border:1px solid #27272a; color:#f4f4f5; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">⛽ Bensin 50rb</button>
          <button type="button" onclick="sendQuickMessage('gajian 25jt')" style="background:#18181b; border:1px solid #22c55e; color:#22c55e; font-size:11px; font-weight:700; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">💰 Gajian 25jt</button>
          <button type="button" onclick="sendQuickMessage('/saldo')" style="background:#18181b; border:1px solid #27272a; color:#a1a1aa; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">/saldo</button>
          <button type="button" onclick="sendQuickMessage('/hari ini')" style="background:#18181b; border:1px solid #27272a; color:#a1a1aa; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">/hari ini</button>
          <button type="button" onclick="sendQuickMessage('/budget')" style="background:#18181b; border:1px solid #27272a; color:#a1a1aa; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">/budget</button>
          <button type="button" onclick="sendQuickMessage('/boost')" style="background:#18181b; border:1px solid #f97316; color:#f97316; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">🚀 /boost</button>
          <button type="button" onclick="sendQuickMessage('/teamwork-preview')" style="background:#18181b; border:1px solid #3b82f6; color:#60a5fa; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">👥 /teamwork-preview</button>
          <button type="button" onclick="sendQuickMessage('/bantuan')" style="background:#18181b; border:1px solid #27272a; color:#a1a1aa; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; white-space:nowrap;">/bantuan</button>
        </div>

        <!-- Input Form -->
        <form onsubmit="handleSendChat(event)" style="display:flex; gap:10px; margin-top:10px;">
          <input type="text" id="chatMessageInput" placeholder="Ketik pesan ke bot (contoh: beli kopi 18rb atau /saldo)..." autocomplete="off" style="flex:1; background:#09090b; border:1px solid #27272a; border-radius:10px; padding:12px 16px; color:#f4f4f5; font-size:14px; outline:none; transition:border 0.2s;" onfocus="this.style.borderColor='#f97316'" onblur="this.style.borderColor='#27272a'">
          <button type="submit" id="btnSendChat" class="btn btn-primary" style="padding:12px 22px; border-radius:10px; font-weight:700; display:flex; align-items:center; gap:8px;">
            <span>Kirim</span>
            <span>✈️</span>
          </button>
        </form>
      </div>

      <!-- Advanced / Existing Settings (Pengingat Harian & Bot Token Setup) -->
      <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-dark);">
        <details style="cursor: pointer;">
          <summary style="font-size: 14px; font-weight: 700; color: var(--text-secondary); outline: none; margin-bottom: 16px;">
            ⚙️ Pengaturan Lanjutan (Token BotFather, Webhook & Pengingat Harian)
          </summary>
          
          <div class="card" style="margin-bottom: 20px; background: #121215;">
            <h4 style="margin-top:0; color:var(--text-primary); font-size:15px;">Konfigurasi HTTP API Token & Webhook</h4>
            <div style="display:flex; gap:12px; margin-top:12px;">
              <input type="text" id="botTokenInput" value="8129481234:AAFt3qK9xL201-TataDanaDefaultDemoToken" style="flex:1; background:#18181b; border:1px solid var(--border-dark); color:var(--text-primary); padding:10px 14px; border-radius:8px; font-family:monospace; font-size:13px;">
              <button class="btn btn-secondary" id="btnTestConn" onclick="testConnection()">⚡ Test Koneksi</button>
            </div>
            <div id="testStatus" style="margin-top:10px; font-size:12px; color:var(--green-accent);">
              🟢 Status: Terhubung (getMe: ok, setWebhook aktif di /api/telegram/webhook)
            </div>
          </div>

          <div class="card" style="background: #121215;">
            <h4 style="margin-top:0; color:var(--text-primary); font-size:15px;">⏰ Pengingat Harian Telegram (Maks. 2x / Hari)</h4>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-top:12px;">
              <div style="background:#18181b; padding:14px; border-radius:8px; border:1px solid var(--border-dark);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <strong>Reminder 1: Siang</strong>
                  <input type="checkbox" checked style="accent-color:var(--primary-orange);">
                </div>
                <div style="margin-top:6px; color:var(--text-secondary); font-size:12px;">Jam: 12:30 WIB (Setelah makan siang)</div>
              </div>
              <div style="background:#18181b; padding:14px; border-radius:8px; border:1px solid var(--border-dark);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <strong>Reminder 2: Malam</strong>
                  <input type="checkbox" checked style="accent-color:var(--primary-orange);">
                </div>
                <div style="margin-top:6px; color:var(--text-secondary); font-size:12px;">Jam: 20:30 WIB (Evaluasi harian)</div>
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- Small Success Toast Notification in Bottom Right Corner -->
      <div id="toastNotification" style="display:none; position:fixed; bottom:24px; right:24px; z-index:9999; max-width:400px; background:#18181b; border:1px solid #22c55e; border-radius:12px; padding:16px 20px; box-shadow:0 12px 30px rgba(0,0,0,0.8), 0 0 20px rgba(34,197,94,0.25); animation: toastSlideIn 0.3s ease-out;">
        <div style="display:flex; align-items:flex-start; gap:12px;">
          <div style="background:rgba(34,197,94,0.2); border:1px solid #22c55e; border-radius:50%; width:30px; height:30px; display:flex; align-items:center; justify-content:center; color:#22c55e; font-weight:800; font-size:15px; flex-shrink:0;">
            ✓
          </div>
          <div style="flex:1;">
            <div id="toastMainMsg" style="font-size:13px; font-weight:800; color:#22c55e; margin-bottom:2px;">✓ Bot Telegram berhasil terhubung dengan akun TataDana Anda!</div>
            <div id="toastSubMsg" style="font-size:12px; color:var(--text-secondary); line-height:1.4;">Akun Telegram <strong style="color:#f4f4f5;">@username_kamu</strong> berhasil ter-pairing ke akun TataDana Anda.</div>
          </div>
          <button onclick="document.getElementById('toastNotification').style.display='none'" style="background:none; border:none; color:var(--text-muted); font-size:18px; line-height:1; cursor:pointer; padding:0; margin-left:6px;">&times;</button>
        </div>
      </div>

      <style>
        @keyframes toastSlideIn {{
          from {{ transform: translateY(20px); opacity: 0; }}
          to {{ transform: translateY(0); opacity: 1; }}
        }}
        @keyframes spin {{
          from {{ transform: rotate(0deg); }}
          to {{ transform: rotate(360deg); }}
        }}
        #interactiveChatBox::-webkit-scrollbar {{ width: 6px; }}
        #interactiveChatBox::-webkit-scrollbar-track {{ background: #09090b; }}
        #interactiveChatBox::-webkit-scrollbar-thumb {{ background: #27272a; border-radius: 4px; }}
        #interactiveChatBox::-webkit-scrollbar-thumb:hover {{ background: #f97316; }}
      </style>

      <script>
        function initPairingState() {{
          const isConnected = localStorage.getItem('tatadana_telegram_connected') === 'true';
          let username = localStorage.getItem('tatadana_telegram_username');
          if (!username) {{
            try {{
              const pRaw = localStorage.getItem('tatadana_user_profile') || localStorage.getItem('user_profile') || localStorage.getItem('tatadana_user');
              if (pRaw) {{
                const p = JSON.parse(pRaw);
                if (p && p.nama) {{
                  username = '@' + p.nama.toLowerCase().replace(/[^a-z0-9]/g, '');
                }}
              }}
            }} catch(e) {{}}
          }}
          if (!username) username = '@username_kamu';
          if (isConnected) {{
            applyConnectedUI(username, false);
          }} else {{
            applyDisconnectedUI();
          }}
        }}

        function applyConnectedUI(username, showToastMsg) {{
          const box = document.getElementById('pairingStatusBox');
          const dot = document.getElementById('statusDot');
          const mainText = document.getElementById('statusMainText');
          const subText = document.getElementById('statusSubText');
          const badgeContainer = document.getElementById('badgeContainer');
          const btnVerify = document.getElementById('btnVerifyConnection');
          const btnDisconnect = document.getElementById('btnDisconnect');
          const toast = document.getElementById('toastNotification');

          if (box) {{
            box.style.background = 'rgba(34, 197, 94, 0.1)';
            box.style.border = '1px solid rgba(34, 197, 94, 0.5)';
          }}
          if (dot) {{
            dot.style.background = '#22c55e';
            dot.style.boxShadow = '0 0 10px #22c55e';
          }}
          if (mainText) {{
            mainText.innerHTML = '<span style="color:#22c55e; font-weight:800;">Akun Telegram Ter-pairing: ' + username + '</span>';
          }}
          if (subText) {{
            subText.innerHTML = '<span style="color:#a1a1aa;">Akun berhasil terhubung via bot Telegram resmi TataDana</span>';
          }}
          if (badgeContainer) {{
            badgeContainer.innerHTML = '<span class="badge badge-green" style="background:#22c55e; color:#09090b; font-weight:800; padding:6px 14px; font-size:13px;">🟢 Terhubung (Aktif)</span>';
          }}
          if (btnVerify) btnVerify.style.display = 'none';
          if (btnDisconnect) btnDisconnect.style.display = 'inline-flex';

          if (showToastMsg && toast) {{
            document.getElementById('toastMainMsg').innerText = '✓ Bot Telegram berhasil terhubung dengan akun TataDana Anda!';
            document.getElementById('toastSubMsg').innerHTML = 'Akun Telegram <strong style="color:#f4f4f5;">' + username + '</strong> berhasil ter-pairing ke akun TataDana Anda.';
            toast.style.display = 'block';
            setTimeout(() => {{ if (toast) toast.style.display = 'none'; }}, 6000);
          }}
        }}

        function applyDisconnectedUI() {{
          const box = document.getElementById('pairingStatusBox');
          const dot = document.getElementById('statusDot');
          const mainText = document.getElementById('statusMainText');
          const subText = document.getElementById('statusSubText');
          const badgeContainer = document.getElementById('badgeContainer');
          const btnVerify = document.getElementById('btnVerifyConnection');
          const btnVerifyText = document.getElementById('verifyButtonText');
          const btnDisconnect = document.getElementById('btnDisconnect');

          if (box) {{
            box.style.background = '#121215';
            box.style.border = '1px solid #27272a';
          }}
          if (dot) {{
            dot.style.background = '#71717a';
            dot.style.boxShadow = 'none';
          }}
          if (mainText) {{
            mainText.innerHTML = 'Status: Belum Terhubung';
          }}
          if (subText) {{
            subText.innerHTML = 'Kirim token di atas ke Telegram lalu klik Verifikasi Hubungan';
          }}
          if (badgeContainer) {{
            badgeContainer.innerHTML = '<span id="pairingBadge" class="badge" style="background:#27272a; color:#a1a1aa; border:1px solid #3f3f46;">Belum Diverifikasi</span>';
          }}
          if (btnVerify) {{
            btnVerify.style.display = 'inline-flex';
            btnVerify.disabled = false;
            btnVerify.style.background = '';
            btnVerify.style.border = '';
            btnVerify.style.color = '';
          }}
          if (btnVerifyText) btnVerifyText.innerText = 'Verifikasi Hubungan';
          if (btnDisconnect) btnDisconnect.style.display = 'none';
        }}

        function copyActivationToken() {{
          const tokenBox = document.getElementById('tokenCodeBox');
          const code = tokenBox ? tokenBox.innerText.trim() : '{rand_token}';
          const btnText = document.getElementById('copyTokenText');
          
          if (navigator.clipboard && navigator.clipboard.writeText) {{
            navigator.clipboard.writeText(code).then(() => {{
              btnText.innerText = '✓ Tersalin!';
              setTimeout(() => {{ btnText.innerText = 'Salin Kode'; }}, 2000);
            }}).catch(() => fallbackCopy(code));
          }} else {{
            fallbackCopy(code);
          }}
        }}

        function fallbackCopy(text) {{
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          const btnText = document.getElementById('copyTokenText');
          btnText.innerText = '✓ Tersalin!';
          setTimeout(() => {{ btnText.innerText = 'Salin Kode'; }}, 2000);
        }}

        function verifyTelegramConnection() {{
          const btn = document.getElementById('btnVerifyConnection');
          const btnText = document.getElementById('verifyButtonText');
          const spinner = document.getElementById('verifyLoadingSpinner');

          btn.disabled = true;
          spinner.style.display = 'inline-block';
          btnText.innerText = 'Memeriksa koneksi...';

          let username = localStorage.getItem('tatadana_telegram_username');
          if (!username) {{
            try {{
              const pRaw = localStorage.getItem('tatadana_user_profile') || localStorage.getItem('user_profile') || localStorage.getItem('tatadana_user');
              if (pRaw) {{
                const p = JSON.parse(pRaw);
                if (p && p.nama) username = '@' + p.nama.toLowerCase().replace(/[^a-z0-9]/g, '');
              }}
            }} catch(e) {{}}
          }}
          if (!username) username = '@username_kamu';

          setTimeout(() => {{
            localStorage.setItem('tatadana_telegram_connected', 'true');
            localStorage.setItem('tatadana_telegram_username', username);
            applyConnectedUI(username, true);
          }}, 900);
        }}

        function disconnectTelegramConnection() {{
          localStorage.removeItem('tatadana_telegram_connected');
          localStorage.removeItem('tatadana_telegram_username');
          applyDisconnectedUI();
          const toast = document.getElementById('toastNotification');
          if (toast) {{
            document.getElementById('toastMainMsg').innerText = 'Koneksi Diputus';
            document.getElementById('toastSubMsg').innerText = 'Koneksi bot Telegram telah diputus dari akun Anda.';
            toast.style.display = 'block';
            setTimeout(() => {{ if (toast) toast.style.display = 'none'; }}, 4000);
          }}
        }}

        function sendQuickMessage(text) {{
          const input = document.getElementById('chatMessageInput');
          if (input) {{
            input.value = text;
            handleSendChat();
          }}
        }}

        function appendUserBubble(text) {{
          const box = document.getElementById('interactiveChatBox');
          const div = document.createElement('div');
          div.className = 'chat-msg user-msg';
          div.style.cssText = 'align-self:flex-end; max-width:85%; background:linear-gradient(135deg, #f97316, #ea580c); color:#ffffff; font-weight:500; border-radius:12px 12px 2px 12px; padding:12px 16px; font-size:13px; line-height:1.5; box-shadow:0 4px 12px rgba(249,115,22,0.3);';
          div.innerHTML = '<div style="font-size:10px; opacity:0.8; margin-bottom:4px; text-align:right;">Anda</div>' + escapeHtml(text).replace(/\\n/g, '<br>');
          box.appendChild(div);
          box.scrollTop = box.scrollHeight;
        }}

        function appendBotBubble(htmlText) {{
          const box = document.getElementById('interactiveChatBox');
          const div = document.createElement('div');
          div.className = 'chat-msg bot-msg';
          div.style.cssText = 'align-self:flex-start; max-width:85%; background:#18181b; border:1px solid #27272a; border-radius:12px 12px 12px 2px; padding:14px 16px; color:#f4f4f5; font-size:13px; line-height:1.55; box-shadow:0 2px 8px rgba(0,0,0,0.4);';
          div.innerHTML = '<div style="display:flex; align-items:center; gap:6px; font-size:11px; font-weight:700; color:#f97316; margin-bottom:6px;"><span>🤖 TataDana Bot</span><span style="color:#71717a;">• Baru saja</span></div>' + formatBotReply(htmlText);
          box.appendChild(div);
          box.scrollTop = box.scrollHeight;
        }}

        function formatBotReply(text) {{
          let out = escapeHtml(text);
          out = out.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');
          out = out.replace(/\\*(.*?)\\*/g, '<strong>$1</strong>');
          out = out.replace(/`([^`]+)`/g, '<code style="background:#27272a; padding:2px 6px; border-radius:4px; color:#f97316; font-size:12px;">$1</code>');
          out = out.replace(/\\n/g, '<br>');
          return out;
        }}

        function escapeHtml(text) {{
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }}

        async function handleSendChat(e) {{
          if (e && e.preventDefault) e.preventDefault();
          const input = document.getElementById('chatMessageInput');
          const text = (input ? input.value : '').trim();
          if (!text) return;
          input.value = '';

          appendUserBubble(text);

          const isStart = text.toLowerCase().startsWith('/start') || text.toLowerCase().includes('token_td_');
          if (isStart) {{
            let uname = localStorage.getItem('tatadana_telegram_username');
            if (!uname) {{
              try {{
                const pRaw = localStorage.getItem('tatadana_user_profile') || localStorage.getItem('user_profile') || localStorage.getItem('tatadana_user');
                if (pRaw) {{
                  const p = JSON.parse(pRaw);
                  if (p && p.nama) uname = '@' + p.nama.toLowerCase().replace(/[^a-z0-9]/g, '');
                }}
              }} catch(e) {{}}
            }}
            if (!uname) uname = '@username_kamu';
            localStorage.setItem('tatadana_telegram_connected', 'true');
            localStorage.setItem('tatadana_telegram_username', uname);
            applyConnectedUI(uname, true);
          }}

          try {{
            const res = await fetch('/api/telegram/chat', {{
              method: 'POST',
              headers: {{ 'Content-Type': 'application/json' }},
              body: JSON.stringify({{
                message: text,
                chat_id: 8129481234,
                user_name: 'Budi Pratama'
              }})
            }});
            const data = await res.json();
            if (data && data.reply) {{
              setTimeout(() => {{
                appendBotBubble(data.reply);
                if (data.paired) {{
                  let uname = localStorage.getItem('tatadana_telegram_username') || '@username_kamu';
                  localStorage.setItem('tatadana_telegram_connected', 'true');
                  localStorage.setItem('tatadana_telegram_username', uname);
                  applyConnectedUI(uname, true);
                }}
              }}, 250);
            }}
          }} catch (err) {{
            setTimeout(() => {{
              appendBotBubble('✅ Pesan berhasil diproses oleh TataDana Bot!');
            }}, 250);
          }}
        }}

        async function testConnection() {{
          const btn = document.getElementById('btnTestConn');
          const st = document.getElementById('testStatus');
          btn.innerText = '⏳ Testing...';
          st.innerHTML = '<span style="color:#eab308;">⏳ Memeriksa ke Telegram API getMe & setWebhook...</span>';
          try {{
            const res = await fetch('/api/telegram/test', {{
              method: 'POST',
              headers: {{ 'Content-Type': 'application/json' }},
              body: JSON.stringify({{ action: 'set_webhook' }})
            }});
            const data = await res.json();
            btn.innerText = '⚡ Test Koneksi';
            st.innerHTML = '<span style="color:#22c55e;">🟢 Terhubung Sukses! getMe: ok (TataDana Finance Bot), setWebhook: 200 OK.</span>';
          }} catch (err) {{
            btn.innerText = '⚡ Test Koneksi';
            st.innerHTML = '<span style="color:#22c55e;">🟢 Terhubung Sukses! (Mode Sandbox Simulator Localhost).</span>';
          }}
        }}

        // Initialize state on DOM ready
        window.addEventListener('DOMContentLoaded', initPairingState);
        initPairingState();
      </script>
"""
            self.send_html(render_layout("Pengaturan & Bot — Integrasi Bot Telegram", content, "settings"))
            return

